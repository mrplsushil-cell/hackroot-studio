# ============================================================================
# Hackroot Studio — Environment Configuration
# Copy to .env and fill in your real values.
# ============================================================================

# ---------- Core ----------
APP_NAME=Hackroot Studio
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ---------- Database ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hackroot
POSTGRES_PASSWORD=hackroot
POSTGRES_DB=hackroot
DATABASE_URL=postgresql+asyncpg://hackroot:hackroot@postgres:5432/hackroot
# For local non-docker dev:
# DATABASE_URL=postgresql+asyncpg://hackroot:hackroot@localhost:5432/hackroot

# ---------- Redis / Queue ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Storage ----------
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_ROOT=/data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# S3 (optional — only if STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Auth ----------
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080         # 7 days

# ---------- LLM ----------
LLM_PROVIDER=mock                # mock | openai | anthropic | google
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# ---------- Image Generation ----------
IMAGE_PROVIDER=mock              # mock | openai | stability | replicate
IMAGE_API_KEY=
IMAGE_MODEL=

# ---------- Video Generation ----------
VIDEO_PROVIDER=mock              # mock | runway | luma | replicate | stability
VIDEO_API_KEY=
VIDEO_MODEL=

# ---------- Text-to-Speech ----------
TTS_PROVIDER=mock                # mock | elevenlabs | openai | google
TTS_API_KEY=
TTS_VOICE_MALE=en-US-male
TTS_VOICE_FEMALE=en-US-female

# ---------- Music ----------
MUSIC_PROVIDER=mock              # mock | suno | udio | replicate
MUSIC_API_KEY=
MUSIC_MODEL=

# ---------- Rendering ----------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_CODEC=libx264
VIDEO_PRESET=medium
VIDEO_CRF=20
AUDIO_CODEC=aac
AUDIO_BITRATE=192k

# ---------- Defaults ----------
DEFAULT_DURATION=20
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_LANGUAGE=English
DEFAULT_STYLE=Cinematic

# ---------- Limits ----------
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60

# ---------- Telemetry ----------
LOG_LEVEL=INFO
SENTRY_DSN=
