# =============================================================================
# Hackroot Studio — PRODUCTION environment (copy to production.env, fill secrets)
# =============================================================================
# NEVER commit the real production.env. This file is a template only.
#
# IMPORTANT — env var names MUST match app/config.py exactly. The names below
# are the real ones the app reads (do not rename):
#   APP_SECRET_KEY   (was mislabeled SECRET_KEY in earlier templates)
#   JWT_SECRET       (was mislabeled JWT_SECRET_KEY)
#   JWT_EXPIRES_MINUTES (was mislabeled ACCESS_TOKEN_EXPIRE_MINUTES)
#   STORAGE_LOCAL_ROOT  (was mislabeled STORAGE_BASE_PATH)
#   CORS_ORIGINS     (comma-separated; see CORS section)
#
# The app FAILS FAST on startup in production if APP_SECRET_KEY / JWT_SECRET /
# DATABASE_URL are empty or still equal to the dev defaults ("change-me").
# =============================================================================

# ---- Core ----
APP_ENV=production
APP_NAME=Hackroot Studio
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
APP_DEBUG=false
FRONTEND_BASE_URL=https://app.hackroot.studio

# ---- Database (asyncpg in prod) ----
DATABASE_URL=postgresql+asyncpg://hackroot:CHANGE_ME_strong_db_password@postgres:5432/hackroot

# ---- Secrets (generate:  openssl rand -hex 32) ----
JWT_SECRET=CHANGE_ME_generate_a_different_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Storage (local | s3). local keeps files on the storage_data volume. ----
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage

# ---- Frontend public API base ----
NEXT_PUBLIC_API_URL=https://api.hackroot.studio

# ---- AI Providers (all default to "mock" — no keys required to run) ----
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
MUSIC_PROVIDER=mock
TTS_PROVIDER=mock
# To go live, set e.g.:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...

# ---- Payments: Razorpay (optional — mock mode when keys absent) ----
# Razorpay secret is ONLY read server-side and is NEVER returned by any API.
# Set BOTH key_id and key_secret together, or signature verification is skipped.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (optional — mock mode when SMTP_* absent) ----
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@hackroot.studio

# ---- CORS (comma-separated origins the browser frontend is served from) ----
CORS_ORIGINS=https://app.hackroot.studio,https://api.hackroot.studio
